#!/bin/sh
# Pre-commit: scan the staged changes with gitleaks using the repo's
# identifier-aware config. Install once per clone with
#   git config core.hooksPath .githooks
# (the root package.json's `prepare` script does this on `bun install`).
set -e
cd "$(git rev-parse --show-toplevel)"
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks)." >&2
  echo "pre-commit: refusing to commit unscanned changes to a public repository." >&2
  exit 1
fi
# The production hostname is identifier-shaped, not credential-shaped, so
# gitleaks cannot catch it; this mirrors that pattern in scan.yml's sweep
# (same excluded paths) over the lines this commit adds. A gitleaks rule
# would instead fail CI's full-history scan on commits already pushed.
hits=$(git diff --cached -U0 --no-color -- . \
  ':!.github/workflows/scan.yml' ':!.gitleaks.toml' ':!.githooks/pre-commit' \
  ':!docs/public-release-plan.md' \
  ':!design-tool/infra/cdk.context.json.example' \
  | grep -E '^(\+\+\+ |\+.*securetest\.psd401\.ai)' \
  | grep -B1 -E '^\+[^+]' || true)
if [ -n "$hits" ]; then
  echo "pre-commit: the production hostname is staged; use <origin> instead:" >&2
  echo "$hits" >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --config .gitleaks.toml --no-banner --redact
