# Copy to .env.local for local dev. Do NOT commit .env.local.

# HS256 secret used to sign / verify the design-tool session JWT.
# Generate with: openssl rand -base64 48
DESIGN_TOOL_SESSION_SECRET=replace-me

# HS256 secret used to sign / verify the short-lived PKCE state cookie
# (separate from the session secret so a session-cookie compromise can't be
# replayed against in-flight PKCE state). Optional — falls back to
# DESIGN_TOOL_SESSION_SECRET if unset, but a distinct value is recommended.
DESIGN_TOOL_PKCE_SECRET=

# Google: https://accounts.google.com (ADR 0017). OIDC_AUDIENCE is comma-separated: web client id, then the native client id. For local smoke
# testing, point at the bundled mock issuer:
#   bun scripts/mock-issuer.mjs   # serves on :4444
#   OIDC_ISSUER=http://localhost:4444
#   OIDC_CLIENT_ID=design-tool-mock-client
OIDC_ISSUER=

# OAuth client_id registered with the IdP (Partner Portal).
OIDC_CLIENT_ID=

# Optional client_secret (some IdPs require it even with PKCE).
OIDC_CLIENT_SECRET=

# Optional audience override for id_token verification. If unset the
# callback enforces aud=OIDC_CLIENT_ID.
OIDC_AUDIENCE=

# Optional explicit redirect_uri. If unset the /api/auth/start route
# derives it from the request origin as `{origin}/api/auth/callback`.
OIDC_REDIRECT_URI=

# Scopes to request at the authorize endpoint. Defaults to
# "openid profile email".
OIDC_SCOPES=

# Local testing escape hatch — when 1, /api/auth/exchange accepts a
# per-request `test_issuer` + `test_jwks` so unit/integration tests can
# sign their own tokens. Never set in production.
ALLOW_TEST_ISSUER=0

# Postgres connection URL. Local dev default points at the homebrew
# `postgresql@16` instance (see ADR 0005). Create the databases with:
#   createdb secure_test_design_tool_dev
#   createdb secure_test_design_tool_test
# Then apply migrations:
#   DATABASE_URL=postgres://${USER}@localhost:5432/secure_test_design_tool_dev bun run db:migrate
#   DATABASE_URL=postgres://${USER}@localhost:5432/secure_test_design_tool_test bun run db:migrate
# NOTE: $USER does NOT shell-expand inside a dotenv file — replace "USER"
# below with your actual OS username (e.g. postgres://jane@localhost:...),
# or you get `role "USER" does not exist` at startup.
DATABASE_URL=postgres://USER@localhost:5432/secure_test_design_tool_dev

# ===========================================================================
# AWS credentials (shared by every Bedrock provider + the S3 storage
# provider). Credentials resolve via the standard AWS chain — AWS_PROFILE,
# access keys, SSO, or an IAM role when deployed — so there is nothing to set
# here for the mock defaults. Region falls back to us-west-2 when unset.
# ===========================================================================
# AWS_REGION=us-west-2
# AWS_PROFILE=your-sso-or-named-profile

# --- AI: item generation (ADR 0007) ---------------------------------------
# "mock" (default) returns deterministic placeholder items so the
# Generate-with-AI panel works with no key. "anthropic" uses the direct
# Anthropic API (needs ANTHROPIC_API_KEY). "bedrock" uses AWS Converse+SigV4.
AI_PROVIDER=mock
# Required only when any provider below is set to "anthropic".
ANTHROPIC_API_KEY=
# Optional model overrides (defaults shown).
# ANTHROPIC_ITEM_MODEL=claude-sonnet-4-6
# BEDROCK_ITEM_MODEL=us.anthropic.claude-sonnet-4-6

# --- AI: math notation translator (ADR 0011) ------------------------------
# mock (default) | anthropic | bedrock. Default model is Haiku 4.5.
MATH_TRANSLATOR_PROVIDER=mock
# ANTHROPIC_MATH_MODEL=claude-haiku-4-5
# BEDROCK_MATH_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- AI: essay scoring (slice 38) -----------------------------------------
# mock (default) | bedrock. Bedrock live-validated 2026-07-09 (Sonnet 4.6,
# ~5s, rubric-valid). Default model is the Sonnet 4.6 item-gen profile.
ESSAY_SCORER_PROVIDER=mock
# BEDROCK_ESSAY_SCORE_MODEL=us.anthropic.claude-sonnet-4-6

# --- AI: PDF item extraction (slice 42) -----------------------------------
# mock (default) | bedrock. Bedrock live-validated 2026-07-09 (Sonnet 4.6,
# ~3.5s, candidates rubric-valid). Text-layer PDFs only; scanned PDFs are
# rejected (OCR not yet supported). Default model is the Sonnet 4.6 profile.
PDF_EXTRACTOR_PROVIDER=mock
# BEDROCK_PDF_EXTRACT_MODEL=us.anthropic.claude-sonnet-4-6

# --- Safeguarding guardrails (ADR 0012) -----------------------------------
# "off" (default) runs AI calls directly with zero overhead and no
# telemetry. "mock" applies deterministic pattern rules (tests/demo).
# "bedrock" calls Bedrock ApplyGuardrail — requires GUARDRAIL_ID.
GUARDRAIL_PROVIDER=off
# The Bedrock guardrail identifier + version (required when provider=bedrock).
# GUARDRAIL_VERSION defaults to DRAFT.
GUARDRAIL_ID=
# GUARDRAIL_VERSION=DRAFT

# --- Storage: image uploads (ADR 0008) ------------------------------------
# "local-fs" (default, writes to STORAGE_LOCAL_ROOT) and "s3" are both wired.
# Reads/deletes route by each asset row's stored provider, so a local-fs->s3
# switch needs no backfill.
STORAGE_PROVIDER=local-fs

# Filesystem root for the local-fs provider. Defaults to ./storage relative
# to design-tool/. The directory is gitignored; create it manually or let
# the first upload create it.
STORAGE_LOCAL_ROOT=./storage

# --- S3 provider (used when STORAGE_PROVIDER=s3) ---
# Required for s3 — the per-env bucket (slice 31 CDK output, e.g.
# secure-test-design-tool-dev).
S3_BUCKET=
# Optional. Falls back to AWS_REGION, then us-west-2.
S3_REGION=
# Optional. Only for a customer-managed KMS key (SSE-KMS). Leave unset for
# SSE-S3 default encryption (ADR 0008 decision 10.2).
# S3_KMS_KEY_ID=
