  "oidcNativeClientId": "000000000000-example-native.apps.googleusercontent.com",
  "mwaaProducerRoleArn": "arn:aws:iam::111111111111:role/service-role/example-mwaa-execution-role",
  "domainName": "example.invalid",
  "guardrailId": "abcdefghijkl",
  "notifyEmail": "<your-email>"
}
