{
  "about": "Golden fixtures for the authored-text markup (R-2, docs/editor-redesign-design.md). `markup` is the stored string; `dom` is what a student sees, in packages/markup/src/rendered.ts's form: a string is text, {b} bold, {i} italic, {math}/{display} a formula's TeX, {img} a resolved picture, {missing} the not-found label, {blank} a fill-in-the-blank gap. `blanks: true` parses as a fill-in-the-blank stem whose item has a blank for every marker. Asset 1111… resolves; every other id does not. Held against the parser (packages/markup), the server renderer and the client renderer (design-tool/test/markup-golden.test.ts).",
  "resolves": ["11111111-1111-1111-1111-111111111111"],
  "fixtures": [
    { "name": "plain text", "markup": "Which of these is a mammal?", "dom": ["Which of these is a mammal?"] },
    { "name": "HTML characters stay characters", "markup": "a < b & \"c\" > 'd' <b>e</b>", "dom": ["a < b & \"c\" > 'd' <b>e</b>"] },
    { "name": "newlines are text", "markup": "line one\nline two", "dom": ["line one\nline two"] },

    { "name": "inline math", "markup": "Solve $x^2 = 9$ for x.", "dom": ["Solve ", { "math": "x^2 = 9" }, " for x."] },
    { "name": "display math", "markup": "$$\\frac{1}{2}$$", "dom": [{ "display": "\\frac{1}{2}" }] },
    { "name": "display math holding a single dollar", "markup": "$$a$b$$", "dom": [{ "display": "a$b" }] },
    { "name": "two formulas", "markup": "$a$ and $b$", "dom": [{ "math": "a" }, " and ", { "math": "b" }] },
    { "name": "math with a space after the opener is math", "markup": "$ 5x+3$", "dom": [{ "math": " 5x+3" }] },
    { "name": "math keeps an escaped dollar inside", "markup": "$a\\$b$", "dom": [{ "math": "a\\$b" }] },
    { "name": "math holding ** stays one formula", "markup": "$x**y**$", "dom": [{ "math": "x**y**" }] },
    { "name": "math holding underscores stays math", "markup": "$x_1 + x_2$", "dom": [{ "math": "x_1 + x_2" }] },

    { "name": "money rule: two prices are prose", "markup": "Costs rose from $57,600 to $30,000.", "dom": ["Costs rose from $57,600 to $30,000."] },
    { "name": "money rule: $5x$ has no marker so is money", "markup": "$5x$", "dom": ["$5x$"] },
    { "name": "money rule: a digit opener with \\times is math", "markup": "$6 \\times 7$", "dom": [{ "math": "6 \\times 7" }] },
    { "name": "money rule: a digit opener with ^ is math", "markup": "$3.5 \\times 10^{4}$ and $2^3$", "dom": [{ "math": "3.5 \\times 10^{4}" }, " and ", { "math": "2^3" }] },
    { "name": "money rule: a price then a formula", "markup": "Pay $5 and solve $x^2$", "dom": ["Pay $5 and solve ", { "math": "x^2" }] },
    { "name": "money rule: price, bold, formula", "markup": "$5 and **bold** $6^2$", "dom": ["$5 and ", { "b": ["bold"] }, " ", { "math": "6^2" }] },
    { "name": "an unmatched dollar is text", "markup": "a $ sign", "dom": ["a $ sign"] },
    { "name": "an unclosed display opener is text", "markup": "$$x", "dom": ["$$x"] },

    { "name": "escaped dollar", "markup": "\\$5 each", "dom": ["$5 each"] },
    { "name": "escaped dollars never open math", "markup": "\\$x\\$", "dom": ["$x$"] },
    { "name": "escaped dollar beside math", "markup": "cost \\$5 and $x$", "dom": ["cost $5 and ", { "math": "x" }] },
    { "name": "a backslash before an escaped dollar", "markup": "a\\\\$x$", "dom": ["a\\$x$"] },
    { "name": "escaped dollar inside bold", "markup": "**\\$5**", "dom": [{ "b": ["$5"] }] },

    { "name": "bold", "markup": "Which is **NOT** true?", "dom": ["Which is ", { "b": ["NOT"] }, " true?"] },
    { "name": "italic", "markup": "an _abiotic_ factor", "dom": ["an ", { "i": ["abiotic"] }, " factor"] },
    { "name": "italic inside bold", "markup": "**a _b_ c**", "dom": [{ "b": ["a ", { "i": ["b"] }, " c"] }] },
    { "name": "bold needs no word boundary", "markup": "a**b**c", "dom": ["a", { "b": ["b"] }, "c"] },
    { "name": "no escape: a literal ** pair becomes bold", "markup": "5**2 and 3**4", "dom": ["5", { "b": ["2 and 3"] }, "4"] },
    { "name": "no escape: ** with spaces inside is not bold", "markup": "2 ** 3 ** 4", "dom": ["2 ** 3 ** 4"] },
    { "name": "bold never crosses a newline", "markup": "**a\nb**", "dom": ["**a\nb**"] },
    { "name": "bold never starts with whitespace", "markup": "** a**", "dom": ["** a**"] },
    { "name": "a run of asterisks is not bold", "markup": "******", "dom": ["******"] },
    { "name": "snake_case stays", "markup": "snake_case and H_2O", "dom": ["snake_case and H_2O"] },
    { "name": "a line of underscores is not italic", "markup": "Name: ______", "dom": ["Name: ______"] },
    { "name": "italic before punctuation", "markup": "_italic_.", "dom": [{ "i": ["italic"] }, "."] },
    { "name": "italic inside brackets", "markup": "(_x_)", "dom": ["(", { "i": ["x"] }, ")"] },
    { "name": "italic inside curly quotes", "markup": "“_x_”", "dom": ["“", { "i": ["x"] }, "”"] },
    { "name": "italic needs a boundary after", "markup": "_x_y", "dom": ["_x_y"] },
    { "name": "emphasis never wraps math", "markup": "**$x$**", "dom": ["**", { "math": "x" }, "**"] },
    { "name": "italic never wraps math", "markup": "_$x$_", "dom": ["_", { "math": "x" }, "_"] },

    { "name": "a resolved picture", "markup": "See ![chart](asset:11111111-1111-1111-1111-111111111111) below.", "dom": ["See ", { "img": { "alt": "chart", "id": "11111111-1111-1111-1111-111111111111" } }, " below."] },
    { "name": "a missing picture shows its alt", "markup": "![map](asset:22222222-2222-2222-2222-222222222222)", "dom": [{ "missing": "map" }] },
    { "name": "a missing picture with no alt shows its id", "markup": "![](asset:22222222-2222-2222-2222-222222222222)", "dom": [{ "missing": "22222222-2222-2222-2222-222222222222" }] },
    { "name": "an upper-case id and scheme still resolve", "markup": "![a](ASSET:11111111-1111-1111-1111-111111111111)", "dom": [{ "img": { "alt": "a", "id": "11111111-1111-1111-1111-111111111111" } }] },
    { "name": "alt text is never markup", "markup": "![**b** $x$](asset:11111111-1111-1111-1111-111111111111)", "dom": [{ "img": { "alt": "**b** $x$", "id": "11111111-1111-1111-1111-111111111111" } }] },
    { "name": "a picture splits a formula", "markup": "$a ![p](asset:11111111-1111-1111-1111-111111111111) b$", "dom": ["$a ", { "img": { "alt": "p", "id": "11111111-1111-1111-1111-111111111111" } }, " b$"] },
    { "name": "a ref that is not a uuid is text", "markup": "![a](asset:not-a-uuid)", "dom": ["![a](asset:not-a-uuid)"] },

    { "name": "blank markers outside a fill-in-the-blank stem are text", "markup": "The [[b1]] is red.", "dom": ["The [[b1]] is red."] },
    { "name": "a blank", "blanks": true, "markup": "The [[b1]] is red.", "dom": ["The ", { "blank": "b1" }, " is red."] },
    { "name": "two blanks", "blanks": true, "markup": "[[b1]] plus [[b2]]", "dom": [{ "blank": "b1" }, " plus ", { "blank": "b2" }] },
    { "name": "a repeated marker stays text", "blanks": true, "markup": "[[b1]] and [[b1]]", "dom": [{ "blank": "b1" }, " and [[b1]]"] },
    { "name": "a blank inside bold", "blanks": true, "markup": "**[[b1]]**", "dom": [{ "b": [{ "blank": "b1" }] }] },
    { "name": "a blank inside italic", "blanks": true, "markup": "_the [[b1]] gap_", "dom": [{ "i": ["the ", { "blank": "b1" }, " gap"] }] },
    { "name": "a blank beside math", "blanks": true, "markup": "$x$ = [[b1]]", "dom": [{ "math": "x" }, " = ", { "blank": "b1" }] }
  ]
}
